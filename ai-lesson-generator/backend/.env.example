# Groq is tried first. Gemini is the automatic backup.
GROQ_API_KEY=put_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=put_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: set to "gemini" to make Gemini primary instead.
AI_PRIMARY_PROVIDER=groq

TAVILY_API_KEY=put_your_tavily_key_here

# ---- LessonForge extras (all optional) ----
# Voice: auto = free Edge neural voices, then espeak if installed. Or force: edge | espeak
TTS_PROVIDER=auto
# Where the video exporter opens the app. Use the Vite dev server in development:
RENDER_BASE_URL=http://127.0.0.1:5173
# Where lessons, audio and videos are stored (default: backend/data)
# LESSONFORGE_DATA=./data
# Requests per minute per IP for the AI/voice/video endpoints
RATE_LIMIT_PER_MINUTE=40
